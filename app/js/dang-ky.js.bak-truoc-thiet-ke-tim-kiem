/* ================================================================
   DANG-KY.JS - Quản lý đăng ký học phần cho sinh viên
   Kết nối Backend PHP thuần & SQLite
   Kiểm tra thời hạn mở/đóng, sĩ số, trùng lịch
   Ràng buộc chuẩn môn bắt buộc trong CTĐT & thứ tự môn tự chọn (A -> B -> C)
   Font Awesome icons, XSS protection
   ================================================================ */

(function ($) {
    'use strict';

    var DangKyModule = {
        currentTab: 'available',

        // Dùng chung header Bearer của Api (một nơi duy nhất tạo "Authorization: Bearer <token>")
        getAuthHeaders: function () {
            return Api.authHeaders();
        },

        render: function () {
            var currentUser = App.getCurrentUser();
            if (!currentUser || currentUser.vai_tro !== 'sinh_vien') {
                $('#contentArea').html('<div class="alert alert-danger"><i class="fa-solid fa-triangle-exclamation"></i> Trang này chỉ dành cho sinh viên</div>');
                return;
            }
            var self = this;
            this.filter = {};
            this.list = [];
            // Bố cục theo mã nguồn cũ (renderRegistrationSection): một thẻ, thanh tìm kiếm, bảng lớp học phần
            var html =
                '<section class="nd-scope">' +
                '  <div class="nd-card">' +
                OldUI.header('Đăng ký môn học', 'Chỉ đăng ký được lớp còn chỗ và không trùng lịch với lớp bạn đã chọn. Lịch được cập nhật sau khi đăng ký.') +
                // UC011 bước 1: chọn học kỳ và năm học
                '    <div class="d-flex align-center gap-2" style="flex-wrap:wrap; margin-top:12px;">' +
                '      <label for="dkHocKy">Học kỳ:</label>' +
                '      <select id="dkHocKy" class="filter-select" style="width:auto;"><option value="1">Học kỳ 1</option><option value="2">Học kỳ 2</option><option value="3">Học kỳ Hè</option></select>' +
                '      <label for="dkNamHoc">Năm học:</label>' +
                '      <select id="dkNamHoc" class="filter-select" style="width:auto;"></select>' +
                '    </div>' +
                // Từ khóa (Bảng 2.21): ô chung tìm theo mã lớp, tên môn, tên giảng viên.
                // Bấm Mã lớp / Môn học / Giảng viên mở hộp nhập nổi ngay dưới nút (không đẩy bố cục); nhiều nút có giá trị thì lọc kết hợp.
                '    <form class="nd-search" id="dkSearch">' +
                '      <span class="nd-search-help">Chọn tiêu chí, nhập từ khóa rồi bấm <strong>Lọc</strong>. Có thể nhập nhiều tiêu chí để lọc kết hợp.</span>' +
                '      <div class="nd-chips">' +
                '        <button type="button" class="nd-chip active" data-field="all">Tất cả</button>' +
                [['ma_lop', 'Mã lớp', 'Nhập mã lớp'], ['mon', 'Môn học', 'Nhập tên hoặc mã môn'], ['giang_vien', 'Giảng viên', 'Nhập tên giảng viên']].map(function (x) {
                    return '<div style="position:relative;">' +
                        '<button type="button" class="nd-chip" data-field="' + x[0] + '">' + x[1] + '</button>' +
                        '<div class="dk-pop" data-field="' + x[0] + '" style="display:none; position:absolute; top:calc(100% + 6px); left:0; z-index:30; width:240px; padding:8px; background:#fff; border:1px solid #dbe4f0; border-radius:12px; box-shadow:0 10px 24px rgba(15,23,42,0.12);">' +
                        '<input type="text" class="dk-field-input" data-field="' + x[0] + '" placeholder="' + x[2] + '" style="width:100%; padding:8px 10px; border-radius:10px; font-size:13px;">' +
                        '</div></div>';
                }).join('') +
                '      </div>' +
                '      <div class="nd-search-actions">' +
                '        <label class="nd-search-input"><span class="nd-search-icon">⌕</span><input type="search" class="nd-keyword" placeholder="Nhập mã lớp, tên môn hoặc tên giảng viên..."></label>' +
                '        <button type="submit" class="nd-btn nd-btn-primary">Lọc</button>' +
                '        <button type="button" class="nd-btn nd-btn-light nd-clear" style="display:none;">Xóa lọc</button>' +
                '      </div>' +
                '      <span class="nd-count"><strong>0</strong>/0</span>' +
                '    </form>' +
                '    <div class="nd-table-wrap"><table class="nd-table">' +
                '      <thead><tr><th>Mã lớp</th><th>Môn học</th><th>Giảng viên</th><th>Tòa nhà / phòng</th><th>Chỗ trống</th><th>Lịch học</th><th>Trạng thái</th><th>Đăng ký</th></tr></thead>' +
                '      <tbody id="dkBody"><tr><td colspan="8" class="nd-empty">Đang tải...</td></tr></tbody>' +
                '    </table></div>' +
                '  </div>' +
                '</section>';
            $('#contentArea').html(html);
            var $f = $('#dkSearch');
            var dongHop = function () { $f.find('.dk-pop').hide(); };
            // Nút sáng khi tiêu chí của nút có giá trị; "Tất cả" sáng khi chưa nhập tiêu chí riêng nào
            var capNhatNut = function () {
                var coTieuChi = false;
                $f.find('.dk-field-input').each(function () {
                    var v = $.trim($(this).val());
                    $f.find('.nd-chip[data-field="' + $(this).data('field') + '"]').toggleClass('active', !!v).attr('title', v);
                    if (v) coTieuChi = true;
                });
                $f.find('.nd-chip[data-field="all"]').toggleClass('active', !coTieuChi);
            };
            $f.on('click', '.nd-chip', function (e) {
                e.stopPropagation();
                var field = $(this).data('field');
                if (field === 'all') {
                    // Bỏ các tiêu chí riêng, chỉ tìm theo ô từ khóa chung
                    $f.find('.dk-field-input').val('');
                    dongHop();
                    capNhatNut();
                    $f.trigger('submit');
                    return;
                }
                var $hop = $f.find('.dk-pop[data-field="' + field + '"]');
                var dangMo = $hop.is(':visible');
                dongHop();
                if (!dangMo) { $hop.show(); $hop.find('input').trigger('focus'); }
            });
            $f.on('click', '.dk-pop', function (e) { e.stopPropagation(); });
            $f.on('input', '.dk-field-input', capNhatNut);
            $f.on('keydown', '.dk-field-input', function (e) { if (e.key === 'Escape') dongHop(); });
            $(document).off('click.dkHop').on('click.dkHop', dongHop);
            $f.on('submit', function (e) {
                e.preventDefault();
                var q = { all: $.trim($f.find('.nd-keyword').val()) };
                $f.find('.dk-field-input').each(function () { q[$(this).data('field')] = $.trim($(this).val()); });
                self.filter = q;
                dongHop();
                $f.find('.nd-clear').toggle(!!(q.all || q.ma_lop || q.mon || q.giang_vien));
                self.renderTable();
            });
            $f.on('click', '.nd-clear', function () {
                $f.find('.nd-keyword, .dk-field-input').val('');
                capNhatNut();
                dongHop();
                $(this).hide();
                self.filter = {};
                self.renderTable();
            });

            $(document).off('click', '.btn-dang-ky-lhp').on('click', '.btn-dang-ky-lhp', function () { self.registerLHP($(this).data('id')); });
            $(document).off('click', '.btn-huy-dang-ky').on('click', '.btn-huy-dang-ky', function () { self.cancelRegistration($(this).data('id')); });

            // Chọn sẵn học kỳ hiện hành (lấy từ dữ liệu), sinh viên có thể đổi sang kỳ khác
            App.fillTermSelects('#dkHocKy', '#dkNamHoc', {}, function () {
                self.loadAvailableList();
            });
            $('#dkHocKy, #dkNamHoc').on('change', function () { self.loadAvailableList(); });
        },

        lichText: function (list, sep) {
            return (list || []).map(function (lh) {
                return App.thuLabel(lh.thu) + ', tiết ' + lh.tiet_bat_dau + ' - ' + lh.tiet_ket_thuc;
            }).join(sep) || '—';
        },

        /** Lớp mở đăng ký (học kỳ hiện hành) + đăng ký của sinh viên (để biết lớp nào có thể hủy) */
        loadAvailableList: function () {
            var self = this;
            var t = { hoc_ky: parseInt($('#dkHocKy').val(), 10) || 1, nam_hoc: $('#dkNamHoc').val() || '' };
            $.when(
                $.ajax({ url: '/api/dangkyhocphan/available', method: 'GET', headers: self.getAuthHeaders(), dataType: 'json',
                         data: { hoc_ky: t.hoc_ky, nam_hoc: t.nam_hoc, search: '' } }),
                $.ajax({ url: '/api/dangkyhocphan/registered', method: 'GET', headers: self.getAuthHeaders(), dataType: 'json', data: {} })
            ).done(function (a, r) {
                var res = a[0] || {}, reg = (r[0] && r[0].data) || [];
                var active = {};
                reg.forEach(function (d) {
                    if (d.trang_thai_dk === 'Đã đăng ký' || d.trang_thai_dk === 'da_dang_ky') active[String(d.lop_hoc_phan_id)] = d;
                });
                self.message = res.message || '';
                self.list = (res.data || []).map(function (l) {
                    var dk = active[String(l.id)];
                    var dong = l.is_open_time === false;
                    return $.extend({}, l, {
                        dk: dk || null,
                        trang_thai_text: dong ? 'Đóng đăng ký' : 'Đang mở',
                        hoc_ky_text: 'HK' + l.hoc_ky + ' ' + (l.nam_hoc || '')
                    });
                });
                self.renderTable();
            }).fail(function (xhr) {
                self.list = [];
                self.message = Api.errorMessage(xhr, 'Lỗi tải danh sách lớp học phần');
                self.renderTable();
                App.showToast(self.message, 'error');
            });
        },

        renderTable: function () {
            var self = this, f = this.filter || {};
            // Một ô khớp khi giá trị chứa đủ các từ đã nhập (không phân biệt hoa/thường, có dấu/không dấu); ô trống thì bỏ qua
            var khop = function (giaTri, tuKhoa) {
                return OldUI.match([giaTri], { query: tuKhoa, field: 'all' });
            };
            var list = this.list.filter(function (l) {
                var mon = (l.ten_mon_hoc || '') + ' ' + (l.ma_mon_hoc || '');
                var gv = l.ten_giang_vien || '';
                return khop([l.ma_lop_hoc_phan, mon, gv].join(' '), f.all)
                    && khop(l.ma_lop_hoc_phan, f.ma_lop)
                    && khop(mon, f.mon)
                    && khop(gv, f.giang_vien);
            });
            OldUI.count('dkSearch', list.length, this.list.length, 'lớp học phần');
            var esc = App.escapeHtml;
            var html = list.map(function (l) {
                var siSo = parseInt(l.si_so_hien_tai, 10) || 0, max = parseInt(l.si_so_toi_da, 10) || 0;
                var dong = l.is_open_time === false;
                var ngay = (l.lich_hoc || []).filter(function (x) { return x.ngay_bat_dau; })[0];
                var btn;
                if (l.dk) {
                    btn = l.dk.co_the_huy === false
                        ? '<button class="nd-btn nd-btn-danger" disabled title="' + esc(l.dk.ly_do_khong_huy || '') + '">Hủy đăng ký</button>' +
                          (l.dk.ly_do_khong_huy ? '<small class="nd-note d-block">' + esc(l.dk.ly_do_khong_huy) + '</small>' : '')
                        : '<button class="nd-btn nd-btn-danger btn-huy-dang-ky" data-id="' + l.dk.dang_ky_id + '">Hủy đăng ký</button>';
                } else if (l.is_registered) {
                    btn = '<button class="nd-btn nd-btn-primary" disabled>Đã đăng ký</button>';
                } else if (dong) {
                    btn = '<button class="nd-btn nd-btn-primary" disabled>Đã đóng</button>';
                } else if (l.is_full) {
                    btn = '<button class="nd-btn nd-btn-primary" disabled>Lớp đã đầy</button>';
                } else {
                    btn = '<button class="nd-btn nd-btn-primary btn-dang-ky-lhp" data-id="' + l.id + '">Đăng ký</button>';
                }
                return '<tr>' +
                    '<td>' + esc(l.ma_lop_hoc_phan) + '</td>' +
                    '<td><div>' + esc(l.ten_mon_hoc || '—') + '</div><small>' + esc(l.ma_mon_hoc || '') + ' - ' + esc(l.hoc_ky_text) + ' · ' + (l.so_tin_chi || 0) + ' TC</small></td>' +
                    '<td>' + esc(l.ten_giang_vien || 'Chưa phân công') + '</td>' +
                    '<td>' + esc(l.phong_hoc || '—') + '</td>' +
                    '<td><strong>' + Math.max(0, max - siSo) + '</strong> / ' + max + '</td>' +
                    '<td><div>' + self.lichText(l.lich_hoc, '<br>') + '</div>' +
                    (ngay ? '<small>Học phần: ' + App.formatDate(ngay.ngay_bat_dau) + ' – ' + App.formatDate(ngay.ngay_ket_thuc) + '</small>' : '') +
                    '</td>' +
                    '<td><span class="nd-pill ' + (dong ? 'nd-pill-neutral' : 'nd-pill-success') + '">' + l.trang_thai_text + '</span>' +
                    (dong && l.thoi_gian_mo_dang_ky && l.thoi_gian_dong_dang_ky
                        ? '<small class="nd-note d-block">Thời gian đăng ký: ' + App.formatDateTime(l.thoi_gian_mo_dang_ky) + ' – ' + App.formatDateTime(l.thoi_gian_dong_dang_ky) + '</small>' : '') +
                    '</td>' +
                    '<td>' + btn + '</td>' +
                    '</tr>';
            }).join('');
            $('#dkBody').html(html || '<tr><td colspan="8" class="nd-empty">' + esc(this.message || 'Chưa có lớp học phần phù hợp.') + '</td></tr>');
        },

        loadRegisteredList: function () { /* đã gộp vào loadAvailableList */ },

        registerLHP: function (lhpId) {
            var self = this;
            var currentUser = App.getCurrentUser();
            if (!currentUser) return;

            $.ajax({
                url: '/api/dangkyhocphan/register',
                method: 'POST',
                headers: self.getAuthHeaders(),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: JSON.stringify({
                    lop_hoc_phan_id: lhpId
                })
            })
            .done(function (res) {
                if (res.success) {
                    App.showToast(res.message || 'Đăng ký học phần thành công!', 'success');
                    self.loadAvailableList();
                    self.loadRegisteredList();
                } else {
                    App.showToast(res.message || 'Đăng ký không thành công!', 'error');
                }
            })
            .fail(function (xhr) {
                var msg = Api.errorMessage(xhr, 'Lỗi khi gửi yêu cầu đăng ký');
                App.showToast(msg, 'error');
            });
        },

        cancelRegistration: function (dkId) {
            var self = this;
            var currentUser = App.getCurrentUser();
            if (!currentUser) return;

            App.confirm('Bạn có chắc chắn muốn hủy đăng ký lớp học phần này?', function () {
                $.ajax({
                    url: '/api/dangkyhocphan/cancel',
                    method: 'POST',
                    headers: self.getAuthHeaders(),
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: JSON.stringify({
                        dang_ky_id: dkId
                    })
                })
                .done(function (res) {
                    if (res.success) {
                        App.showToast(res.message || 'Đã hủy đăng ký thành công!', 'info');
                        self.loadAvailableList();
                        self.loadRegisteredList();
                    } else {
                        App.showToast(res.message || 'Không thể hủy đăng ký!', 'error');
                    }
                })
                .fail(function (xhr) {
                    var msg = Api.errorMessage(xhr, 'Lỗi khi hủy đăng ký');
                    App.showToast(msg, 'error');
                });
            });
        }
    };

    App.registerModule('dang-ky', DangKyModule);
})(jQuery);
